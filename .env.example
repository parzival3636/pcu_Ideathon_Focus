# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=study_analytics
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_password
POSTGRES_SSLMODE=prefer

# ZenRows Configuration
ZENROWS_API_KEY=your_api_key_here
ZENROWS_BASE_URL=https://api.zenrows.com/v1/
ZENROWS_TIMEOUT=30
ZENROWS_RETRY_ATTEMPTS=3
ZENROWS_RATE_LIMIT_DELAY=1.0

# Application Configuration
MIN_PRODUCTIVE_SESSIONS=10
TOP_N_TOPICS=5
MIN_BLOGS_PER_TOPIC=10
MIN_PAPERS_PER_TOPIC=5
MAX_RECOMMENDATIONS_PER_TOPIC=20
MIN_QUALITY_SCORE=0.6
MAX_CONTENT_AGE_YEARS=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
